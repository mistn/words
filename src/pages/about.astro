---
import '../styles/global.css';
const rawSheets = import.meta.glob('../data/sheets/*.json', { eager: true });
const sheets = Object.entries(rawSheets)
  .filter(([p]) => !p.includes('_template'))
  .map(([, mod]: any) => (mod as any).default ?? mod)
  .sort((a:any,b:any) => String(a.id).localeCompare(String(b.id)));
const totalWords = sheets.reduce((s:any,sh:any)=> s+ sh.categories.reduce((n:any,c:any)=>n+c.words.length,0),0);
---
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="About this vocabulary site: source book and contact." />
    <link rel="icon" href="/favicon.svg?v=3" type="image/svg+xml" />
    <title>About — Interactive Vocabulary</title>
  </head>
  <body class="bg-[#f8f7f5] text-slate-800 min-h-screen antialiased">
    <main class="max-w-[760px] mx-auto px-4 md:px-6 py-10">
      <div class="bg-white rounded-2xl border border-slate-200 shadow-sm px-6 py-8 md:px-10">
        <h1 class="text-2xl font-bold tracking-tight text-slate-900">About</h1>
        <p class="mt-4 text-sm leading-relaxed text-slate-600">
          All vocabulary on this site is transcribed from the book
          <b>“Toppers Dictionary for Secondary Stage 2022”</b>,
          compiled and edited by the <b>Toppers Team</b>, in original book order.
        </p>
        <p class="mt-3 text-sm leading-relaxed text-slate-600">
          Coverage: {sheets.length} units · {totalWords} words — Part 1 topics,
          Part 2 A–Z, expressions &amp; idioms, and irregular verbs.
        </p>
        <p class="mt-3 text-sm leading-relaxed text-slate-600">
          British pronunciation is produced on-device via your browser's speech engine (en-GB voice).
        </p>
        <h2 class="mt-6 text-base font-bold text-slate-900">No British voice on your phone?</h2>
        <p class="mt-2 text-sm leading-relaxed text-slate-600">
          Install the <b>Speech Services by Google</b> app, set it as the preferred text-to-speech
          engine, then download the <b>English (UK)</b> voice pack (tens of MB, one time).
          Afterwards every word on this site reads aloud in British English, even offline.
          iPhone and desktop browsers (Edge/Chrome) already include a British voice.
        </p>
        <p class="mt-3 text-sm leading-relaxed text-slate-600">
          Found a mistake? Contact <a href="mailto:contact@miuarc.com" class="text-rose-600 hover:underline">contact@miuarc.com</a>.
        </p>
        <p class="mt-6">
          <a href="/" class="inline-block rounded-full bg-slate-900 text-white px-5 py-2 text-sm font-medium hover:bg-slate-700">← Back to vocabulary</a>
        </p>
      </div>
    </main>
  </body>
</html>
