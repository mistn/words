---
import vocabData from '../data/vocab.json';
import '../styles/global.css';
const rawSheets = import.meta.glob('../data/sheets/*.json', { eager: true });
const sheetsFromFiles = Object.entries(rawSheets)
  .filter(([p]) => !p.includes('_template'))
  .map(([, mod]: any) => (mod as any).default ?? mod)
  .sort((a:any,b:any) => String(a.id).localeCompare(String(b.id)));
const sheets = sheetsFromFiles.length ? sheetsFromFiles : [{ id: '01', title: 'Sheet 01 — ① Arts / ② Cinema / ③ Education', categories: vocabData }];
const defaultSheet = sheets[0];
const totalWords = sheets.reduce((s:any,sh:any)=> s+ sh.categories.reduce((n:any,c:any)=>n+c.words.length,0),0);
const countBy = (pred:(s:any)=>boolean) => sheets.filter(pred).length;
const wordsBy = (pred:(s:any)=>boolean) => sheets.filter(pred).reduce((s:any,sh:any)=> s+sh.categories.reduce((n:any,c:any)=>n+c.words.length,0),0);
const isPart1 = (s:any) => /Part 1/.test(s.source||'') || /^[0-2][0-9]-/.test(s.id) && parseInt(s.id)<=23;
const isIdioms = (s:any) => /Idiom/.test(s.title);
const isVerbs = (s:any) => /Verb/.test(s.title);
const isPart2 = (s:any) => !isPart1(s) && !isIdioms(s) && !isVerbs(s);
const part1Count = countBy(isPart1); const part2Count = countBy(isPart2);
const part1Words = wordsBy(isPart1); const part2Words = wordsBy(isPart2);
const idiomsWords = wordsBy(isIdioms); const verbsWords = wordsBy(isVerbs);
const groupOf = (s:any) => isPart1(s) ? 'Part 1 — Topics' : isPart2(s) ? 'Part 2 — A–Z' : isIdioms(s) ? 'Expressions' : 'Verbs';
const grouped: Record<string,any[]> = {};
for (const s of sheets) { const g = groupOf(s); (grouped[g] ??= []).push(s); }
---
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="Interactive English-Arabic vocabulary — click to hear British English (en-GB 0.9). Part 1 topics, Part 2 A-Z, idioms and irregular verbs. SpeechSynthesis, RTL Arabic, responsive cards/table." />
    <meta property="og:title" content="Interactive English–Arabic Vocabulary — British Pronunciation" />
    <meta property="og:description" content="Click any English word to hear British pronunciation. Book order, 2700+ words." />
    <link rel="icon" href="/favicon.svg?v=3" type="image/svg+xml" />
    <link rel="manifest" href="/manifest.json" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700&family=Noto+Naskh+Arabic:wght@500;700&display=swap" rel="stylesheet" />
    <title>Interactive Vocabulary — British Pronunciation</title>
  </head>
  <body class="bg-[#f8f7f5] text-slate-800 min-h-screen antialiased">
    <div id="aria-live" aria-live="polite" aria-atomic="true" class="sr-only"></div>
    <header class="max-w-[1360px] mx-auto px-4 md:px-6 pt-6 pb-4">
      <div class="bg-white rounded-2xl border border-slate-200 shadow-sm px-5 py-5 md:px-7 md:py-6">
        <div class="flex flex-col gap-3">
          <div class="min-w-0 flex flex-wrap items-baseline gap-x-3 gap-y-1">
            <h1 class="text-xl md:text-2xl font-bold tracking-tight text-slate-900">Interactive English–Arabic Syllabus</h1>
            <p class="text-xs text-slate-400 mt-1">Part 1 topics {part1Count} · {part1Words} words · Part 2 A–Z {part2Count} · {part2Words} words · Idioms {idiomsWords} · Verbs {verbsWords} · {sheets.length} units · {totalWords} total</p>
          </div>
          <div class="flex flex-wrap items-center gap-2">
            <select id="sheet-select" aria-label="Select vocabulary sheet" class="rounded-full border border-slate-200 bg-white px-3 py-2 text-sm font-medium max-w-[260px]">
              {Object.entries(grouped).map(([g, list]: any) => (
                <optgroup label={g}>
                  {(list as any[]).map((s:any) => (
                    <option value={s.id} selected={s.id===defaultSheet.id}>{s.title} ({s.categories.reduce((n:any,c:any)=>n+c.words.length,0)})</option>
                  ))}
                </optgroup>
              ))}
            </select>
            <select id="voice-select" aria-label="Select British voice" class="rounded-full border border-slate-200 bg-white px-3 py-2 text-sm font-medium max-w-[200px]"><option>Loading voices…</option></select>
            <button id="autoplay-btn" type="button" class="inline-flex items-center gap-1.5 rounded-full border border-rose-200 bg-rose-50 hover:bg-rose-100 text-rose-700 px-4 py-2 text-sm font-medium"><span class="ic-play inline-flex"><svg width="11" height="11" viewBox="0 0 12 12" fill="currentColor" aria-hidden="true"><path d="M3 1.5v9l7-4.5z"/></svg></span><span class="ic-pause hidden"><svg width="11" height="11" viewBox="0 0 12 12" fill="currentColor" aria-hidden="true"><rect x="2.5" y="1.5" width="2.8" height="9" rx="1"/><rect x="6.7" y="1.5" width="2.8" height="9" rx="1"/></svg></span><span class="lbl">Auto</span></button>
            <button id="stop-btn" type="button" class="inline-flex items-center gap-1.5 rounded-full border border-slate-200 bg-slate-50 hover:bg-slate-100 px-4 py-2 text-sm font-medium"><svg width="11" height="11" viewBox="0 0 12 12" fill="currentColor" aria-hidden="true" class="text-slate-500"><rect x="1.5" y="1.5" width="9" height="9" rx="1.5"/></svg><span>Stop</span></button>
            <button id="prev-btn" type="button" title="Previous unit" class="rounded-full border border-slate-200 bg-white hover:bg-slate-50 px-3 py-2 text-sm font-medium">‹ Prev</button>
            <button id="next-btn" type="button" title="Next unit" class="rounded-full border border-slate-200 bg-white hover:bg-slate-50 px-3 py-2 text-sm font-medium">Next ›</button>
            <button id="focus-btn" type="button" title="Focus mode" class="rounded-full border border-slate-200 bg-slate-900 hover:bg-slate-700 text-white px-4 py-2 text-sm font-medium">⛶ Focus</button>
            <input id="search" placeholder="Search English / Arabic… (/)" class="ml-auto w-full md:w-48 rounded-full border border-slate-200 bg-slate-50 px-4 py-2 text-sm outline-none focus:bg-white focus:border-rose-300 focus:ring-2 focus:ring-rose-100" />
          </div>
        </div>
        <p id="voice-hint" class="mt-2 text-xs text-amber-600 hidden"></p>
      </div>
    </header>
    <div id="focus-bar" class="fixed top-0 inset-x-0 z-50 items-center gap-1.5 md:gap-2 overflow-x-auto bg-slate-900/95 text-white px-3 md:px-4 py-2.5 shadow-lg" style="display:none">
      <button id="exit-focus-btn" type="button" class="rounded-full bg-white/10 hover:bg-white/20 px-3 py-1.5 text-sm font-medium shrink-0">✕ Exit</button>
      <button id="fprev-btn" type="button" class="rounded-full bg-white/10 hover:bg-white/20 px-3 md:px-4 py-1.5 text-sm font-medium shrink-0">‹ Prev</button>
      <span id="focus-title" class="min-w-0 flex-1 text-center font-bold text-sm md:text-base truncate"></span>
      <span id="focus-status" class="hidden md:inline text-xs text-white/60 min-w-[90px] text-right"></span>
      <button id="fauto-btn" type="button" class="inline-flex items-center gap-1.5 rounded-full bg-white/10 hover:bg-white/20 px-3 md:px-4 py-1.5 text-sm font-medium shrink-0"><span class="ic-play inline-flex"><svg width="11" height="11" viewBox="0 0 12 12" fill="currentColor" aria-hidden="true"><path d="M3 1.5v9l7-4.5z"/></svg></span><span class="ic-pause hidden"><svg width="11" height="11" viewBox="0 0 12 12" fill="currentColor" aria-hidden="true"><rect x="2.5" y="1.5" width="2.8" height="9" rx="1"/><rect x="6.7" y="1.5" width="2.8" height="9" rx="1"/></svg></span><span class="lbl">Auto</span></button>
      <button id="fstop-btn" type="button" class="inline-flex items-center gap-1.5 rounded-full bg-white/10 hover:bg-white/20 px-3 md:px-4 py-1.5 text-sm font-medium shrink-0"><svg width="11" height="11" viewBox="0 0 12 12" fill="currentColor" aria-hidden="true"><rect x="1.5" y="1.5" width="9" height="9" rx="1.5"/></svg><span>Stop</span></button>
      <button id="fnext-btn" type="button" class="rounded-full bg-white/10 hover:bg-white/20 px-3 md:px-4 py-1.5 text-sm font-medium shrink-0">Next ›</button>
    </div>

    <main class="max-w-[1360px] mx-auto px-4 md:px-6 pb-10">
      <div id="table-view" class="bg-white rounded-2xl border border-slate-200 overflow-hidden shadow-sm">
        <div class="overflow-x-auto">
          <table class="w-full text-sm border-collapse">
            <thead class="bg-slate-50 text-slate-500 text-xs">
              <tr>
                <th class="text-left font-semibold px-4 py-2 w-[28%]">English</th>
                <th class="text-right font-semibold px-4 py-2 w-[22%]" dir="rtl" style="font-family:'Noto Naskh Arabic',serif">العربية</th>
                <th class="hidden md:table-cell text-left font-semibold px-4 py-2 w-[28%] border-l border-slate-200">English</th>
                <th class="hidden md:table-cell text-right font-semibold px-4 py-2 w-[22%]" dir="rtl" style="font-family:'Noto Naskh Arabic',serif">العربية</th>
              </tr>
            </thead>
            <tbody id="table-body" class="divide-y divide-rose-100"></tbody>
          </table>
        </div>
      </div>

    </main>
    <footer class="pb-6 text-center text-xs text-slate-400"><a href="/about" class="hover:text-rose-500">About &amp; source</a> · <a href="mailto:contact@miuarc.com" class="hover:text-rose-500">contact@miuarc.com</a></footer>

    <style is:global>
      @keyframes bar { 0%,100%{ transform: scaleY(0.6)} 50%{ transform: scaleY(1)} }
      .row-btn.playing { background:#fff1f2 !important; }
      .row-btn.playing .ico { background:#f43f5e !important; }
      td.cell-playing { background:#fff1f2 !important; }
      td.cell-hover { background:rgba(255,241,242,.7); }
      .row-btn.selected { outline:2px solid #f43f5e; outline-offset:-2px; }
      .row-btn.playing .en-text { color:#e11d48; }
      .row-btn { scroll-margin-top:72px; }
      body.immersive header { display:none; }
      body.immersive #focus-bar { display:flex !important; }
      body.immersive main { padding-top:64px; }
      body.immersive #units-help, body.immersive footer { display:none; }
      .sr-only{position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap;border:0}
    </style>

    <script id="sheets-data" type="application/json" set:html={JSON.stringify(sheets)}></script>
    <script>
      const sheets = JSON.parse(document.getElementById('sheets-data').textContent);
      const tableView = document.getElementById('table-view');
      const tableBody = document.getElementById('table-body');
      const sheetSelect = document.getElementById('sheet-select');
      const voiceSelect = document.getElementById('voice-select');
      const voiceHint = document.getElementById('voice-hint');
      const searchInput = document.getElementById('search');
      const statusEl = document.getElementById('status');
      const ariaLive = document.getElementById('aria-live');
      const stopBtn = document.getElementById('stop-btn');
      const autoplayBtn = document.getElementById('autoplay-btn');
      const rateInput = document.getElementById('rate');
      const rateVal = document.getElementById('rate-val');
      let currentBtn = null;
      let selectedBtn = null;
      let currentSheetId = sheets[0]?.id;
      let filterText = '';
      let selectedVoice = null;
      let rate = 0.9;
      let autoplay = false;
      let autoplayQueue = [];
      let autoplayIndex = 0;

      function setStatus(t){ if(statusEl) statusEl.textContent=t; if(ariaLive) ariaLive.textContent=t; const fs=document.getElementById('focus-status'); if(fs) fs.textContent=t; }
      function paintAuto(){
        const b2 = document.getElementById('fauto-btn');
        [autoplayBtn, b2].forEach(b=>{
          if(!b) return;
          const lbl = b.querySelector('.lbl'); if(lbl) lbl.textContent = autoplay ? 'Pause' : 'Auto';
          const p = b.querySelector('.ic-play'); if(p) p.classList.toggle('hidden', autoplay);
          const pa = b.querySelector('.ic-pause'); if(pa) pa.classList.toggle('hidden', !autoplay);
          b.classList.toggle('bg-rose-500', autoplay);
          b.classList.toggle('text-white', autoplay);
          if(b !== autoplayBtn) b.classList.toggle('bg-white/10', !autoplay);
        });
      }

      function populateVoices(){
        if(!voiceSelect) return;
        const voices = window.speechSynthesis.getVoices();
        const gbVoices = voices.filter(v=> v.lang==='en-GB' || v.lang.toLowerCase().includes('en-gb'));
        const list = gbVoices.length ? gbVoices : voices.filter(v=> v.lang.startsWith('en'));
        voiceSelect.innerHTML = list.map(v=> `<option value="${v.name}">${v.name} — ${v.lang}${v.default?' ★':''}</option>`).join('') || '<option>No voices</option>';
        if(gbVoices.length){
          selectedVoice = gbVoices[0];
          voiceSelect.value = selectedVoice.name;
          voiceHint.classList.add('hidden');
        } else if(list.length){
          selectedVoice = list[0];
          voiceSelect.value = selectedVoice.name;
          voiceHint.textContent = 'No en-GB voice found on this device — using '+selectedVoice.name+' ('+selectedVoice.lang+'). For authoritative British, use Chrome/Edge on desktop or install UK voice in OS settings.';
          voiceHint.classList.remove('hidden');
        } else {
          voiceHint.textContent = 'No English voices available.';
          voiceHint.classList.remove('hidden');
        }
      }
      if('speechSynthesis' in window){
        populateVoices();
        window.speechSynthesis.onvoiceschanged = populateVoices;
        setTimeout(populateVoices, 300);
      }
      voiceSelect?.addEventListener('change', e=>{
        const voices = window.speechSynthesis.getVoices();
        selectedVoice = voices.find(v=> v.name===e.target.value) || null;
      });
      rateInput?.addEventListener('input', e=>{ rate=parseFloat(e.target.value); rateVal.textContent=rate.toFixed(2); });

      function speak(text, btn){
        if(!('speechSynthesis' in window)){ alert('Browser does not support text-to-speech.'); return; }
        window.speechSynthesis.cancel();
        autoplay = false; paintAuto();
        const u = new SpeechSynthesisUtterance(text);
        u.lang = 'en-GB'; u.rate = rate;
        if(selectedVoice) u.voice = selectedVoice;
        else {
          const voices = window.speechSynthesis.getVoices();
          const gb = voices.find(v=> v.lang==='en-GB' || v.lang.toLowerCase().includes('en-gb'));
          if(gb) u.voice = gb;
        }
        markPlaying(btn,true); currentBtn=btn; setSelected(btn);
        setStatus('🔊 ' + text);
        u.onend = ()=>{ markPlaying(btn,false); if(currentBtn===btn) currentBtn=null; setStatus('Ready'); if(autoplay) playNextInQueue(); };
        u.onerror = ()=>{ markPlaying(btn,false); if(currentBtn===btn) currentBtn=null; setStatus('Ready'); };
        window.speechSynthesis.speak(u);
      }

      function setSelected(btn){
        if(selectedBtn) selectedBtn.classList.remove('selected');
        selectedBtn = btn;
        if(btn) btn.classList.add('selected');
      }

      function pairCells(btn){
        const tds = [];
        const td = btn && btn.closest ? btn.closest('td') : null;
        if(td){
          tds.push(td);
          const ar = td.nextElementSibling;
          if(ar && ar.tagName==='TD') tds.push(ar);
        }
        return tds;
      }
      function markPlaying(btn,on){
        if(!btn) return;
        btn.classList.toggle('playing',on);
        pairCells(btn).forEach(td=> td.classList.toggle('cell-playing',on));
      }
      function clearPlaying(){ if(currentBtn){ markPlaying(currentBtn,false); } currentBtn=null; }
      function getAllWordButtons(){
        const L = [...tableView.querySelectorAll('[data-col="l"]')];
        const R = [...tableView.querySelectorAll('[data-col="r"]')];
        const vis = (list) => list.filter(b => b.offsetParent !== null);
        return [...vis(L), ...vis(R)];
      }
      function getFilteredCategories(){
        const sheet = sheets.find(s=> String(s.id)===String(currentSheetId)) || sheets[0];
        if(!filterText) return sheet.categories;
        const q = filterText.toLowerCase();
        return sheet.categories.map(cat=> ({...cat, words: cat.words.filter(w=> w.en.toLowerCase().includes(q) || w.ar.includes(filterText))})).filter(c=>c.words.length>0);
      }

      function render(){
        const cats = getFilteredCategories();
        const BTN = 'row-btn group w-full flex items-center gap-2 text-left -mx-4 -my-2 px-4 py-2 transition-colors focus:outline-none focus-visible:ring-2 focus-visible:ring-rose-300';
        const ICO = '<span class="ico shrink-0 w-5 h-5 rounded-full bg-slate-100 flex items-center justify-center text-[11px] group-[.playing]:bg-rose-500"><span class="group-[.playing]:hidden">🔊</span><span class="hidden group-[.playing]:inline-flex items-center gap-[2px]"><span class="w-[2px] h-2 bg-white rounded-full animate-[bar_0.6s_ease-in-out_infinite]"></span><span class="w-[2px] h-1.5 bg-white rounded-full animate-[bar_0.6s_ease-in-out_0.15s_infinite]"></span><span class="w-[2px] h-2.5 bg-white rounded-full animate-[bar_0.6s_ease-in-out_0.3s_infinite]"></span></span></span>';
        const ARF = "font-family:'Noto Naskh Arabic',serif";
        const wbtn = (w, side) => `<button data-word="${w.en.replace(/"/g,'&quot;')}" data-col="${side}" aria-label="Play ${w.en.replace(/"/g,'')}" class="${BTN}">${ICO}<span class="en-text font-medium">${w.en}</span></button>`;
        const enTd = (w, right) => `<td class="${right ? 'hidden md:table-cell px-4 py-2 border-t border-l border-rose-100' : 'px-4 py-2 border-t border-rose-100'}">${w ? wbtn(w, right ? 'r' : 'l') : ''}</td>`;
        const arTd = (w, hide) => `<td class="${hide} px-4 py-2 text-right border-t border-rose-100" dir="rtl" style="${ARF}">${w ? w.ar : ''}</td>`;
        let rows = '';
        const narrow = window.innerWidth < 768;
        cats.forEach(cat => {
          rows += `<tr class="bg-[#fde2e6]"><td colspan="4" class="px-4 py-2 font-bold text-rose-700 text-center border-t border-rose-200">${cat.category}</td></tr>`;
          const ws = cat.words;
          if (narrow) {
            ws.forEach(w => { rows += `<tr>${enTd(w, false)}${arTd(w, '')}</tr>`; });
            return;
          }
          const k = Math.ceil(ws.length / 2);
          for (let i = 0; i < k; i++) {
            const a = ws[i], b = ws[i + k];
            rows += `<tr>${enTd(a, false)}${arTd(a, '')}${enTd(b, true)}${arTd(b, 'hidden md:table-cell')}</tr>`;
          }
        });
        tableBody.innerHTML = rows || `<tr><td colspan="4" class="px-6 py-8 text-center text-slate-400">No matches</td></tr>`;
        autoplayQueue = getAllWordButtons();
        if(selectedBtn && !document.contains(selectedBtn)) selectedBtn=null;
      }

      function playNextInQueue(){
        if(!autoplay || autoplayIndex >= autoplayQueue.length){ autoplay=false; paintAuto(); setStatus('Ready'); return; }
        const btn = autoplayQueue[autoplayIndex++];
        const r = btn.getBoundingClientRect();
        if (r.top < 72 || r.bottom > window.innerHeight) {
          btn.scrollIntoView({block:'start', behavior:'smooth'});
        }
        setSelected(btn);
        if(!('speechSynthesis' in window)) return;
        window.speechSynthesis.cancel();
        clearPlaying();
        const text = btn.getAttribute('data-word');
        const u = new SpeechSynthesisUtterance(text);
        u.lang='en-GB'; u.rate=rate; if(selectedVoice) u.voice=selectedVoice;
        markPlaying(btn,true); currentBtn=btn; setStatus('🔊 '+(autoplayIndex)+'/'+autoplayQueue.length+' '+text);
        u.onend = ()=>{ markPlaying(btn,false); if(currentBtn===btn) currentBtn=null; setTimeout(playNextInQueue, 350); };
        u.onerror = ()=>{ markPlaying(btn,false); setTimeout(playNextInQueue, 350); };
        window.speechSynthesis.speak(u);
      }

      document.addEventListener('click', e=>{
        const btn = e.target.closest('[data-word]');
        if(btn) speak(btn.getAttribute('data-word'), btn);
      });
      let hoverTds = [];
      function clearHover(){ hoverTds.forEach(td=> td.classList.remove('cell-hover')); hoverTds=[]; }
      tableView?.addEventListener('mouseover', e=>{
        const btn = e.target.closest ? e.target.closest('[data-word]') : null;
        if(!btn || !tableView.contains(btn)) return;
        clearHover();
        hoverTds = pairCells(btn);
        hoverTds.forEach(td=> td.classList.add('cell-hover'));
      });
      tableView?.addEventListener('mouseout', e=>{
        const to = e.relatedTarget;
        if(to && to.closest && to.closest('[data-word]') && tableView.contains(to.closest('[data-word]'))){
          const a = to.closest('[data-word]'), b = e.target.closest ? e.target.closest('[data-word]') : null;
          if(a===b) return;
        }
        clearHover();
      });

      sheetSelect?.addEventListener('change', e=>{ currentSheetId=e.target.value; render(); syncFocusTitle(); });
      const gotoSheet = (d)=>{
        const i = sheets.findIndex(s=> String(s.id)===String(currentSheetId));
        const n = (i+d+sheets.length)%sheets.length;
        autoplay=false; paintAuto();
        if('speechSynthesis' in window) window.speechSynthesis.cancel();
        clearPlaying();
        currentSheetId = sheets[n].id;
        if(sheetSelect) sheetSelect.value = sheets[n].id;
        render(); syncFocusTitle();
        setStatus(sheets[n].title);
        window.scrollTo({top:0, behavior:'smooth'});
      };
      const setFocus = (on)=>{ document.body.classList.toggle('immersive', on); if(on) syncFocusTitle(); window.scrollTo({top:0}); };
      const syncFocusTitle = ()=>{ const s = sheets.find(x=> String(x.id)===String(currentSheetId)) || sheets[0]; const el=document.getElementById('focus-title'); if(el&&s) el.textContent = `${s.title} · ${s.categories.reduce((n,c)=>n+c.words.length,0)} words`; };
      document.getElementById('prev-btn')?.addEventListener('click', ()=> gotoSheet(-1));
      document.getElementById('next-btn')?.addEventListener('click', ()=> gotoSheet(1));
      document.getElementById('fprev-btn')?.addEventListener('click', ()=> gotoSheet(-1));
      document.getElementById('fnext-btn')?.addEventListener('click', ()=> gotoSheet(1));
      document.getElementById('focus-btn')?.addEventListener('click', ()=> setFocus(true));
      document.getElementById('exit-focus-btn')?.addEventListener('click', ()=> setFocus(false));
      searchInput?.addEventListener('input', e=>{ filterText=e.target.value.trim(); render(); });
      let wasNarrow = window.innerWidth < 768;
      window.addEventListener('resize', ()=>{
        const n = window.innerWidth < 768;
        if(n !== wasNarrow){ wasNarrow = n; render(); }
      });
      stopBtn?.addEventListener('click', ()=>{
        autoplay=false; paintAuto();
        window.speechSynthesis.cancel();
        clearPlaying(); setStatus('Stopped'); setTimeout(()=>setStatus('Ready'),800);
      });
      autoplayBtn?.addEventListener('click', ()=>{
        if(autoplay){ autoplay=false; paintAuto(); window.speechSynthesis.cancel(); setStatus('Stopped'); return; }
        autoplayQueue = getAllWordButtons();
        if(!autoplayQueue.length) return;
        autoplay=true; autoplayIndex=0; paintAuto();
        playNextInQueue();
      });
      document.getElementById('fauto-btn')?.addEventListener('click', ()=> autoplayBtn.click());
      document.getElementById('fstop-btn')?.addEventListener('click', ()=> stopBtn.click());

      document.addEventListener('keydown', e=>{
        if(e.target.tagName==='INPUT' && e.key!=='Escape') return;
        if(e.key==='/'){ e.preventDefault(); searchInput.focus(); return; }
        if(e.key==='Escape'){ autoplay=false; paintAuto(); window.speechSynthesis.cancel(); clearPlaying(); setFocus(false); setStatus('Ready'); return; }
        if(e.key==='Enter' && selectedBtn){ e.preventDefault(); speak(selectedBtn.getAttribute('data-word'), selectedBtn); return; }
        if(e.key==='ArrowDown' || e.key==='ArrowUp'){
          e.preventDefault();
          const btns = getAllWordButtons();
          if(!btns.length) return;
          let idx = selectedBtn ? btns.indexOf(selectedBtn) : -1;
          idx = e.key==='ArrowDown' ? Math.min(btns.length-1, idx+1) : Math.max(0, idx-1);
          if(idx<0) idx=0;
          setSelected(btns[idx]); btns[idx].scrollIntoView({block:'nearest'}); btns[idx].focus({preventScroll:true});
        }
      });

      render();
      syncFocusTitle();
    </script>
  </body>
</html>
